# ==========================================
# Pavithra Travels - Environment Configuration
# ==========================================

# ------------------------------------------
# FRONTEND CONFIGURATION (Vite)
# ------------------------------------------
# The full URL of your backend API. 
# LOCAL: Use /api (proxied via vite.config.ts) or http://localhost:10000/api
# PRODUCTION (Render): MUST use absolute URL, e.g., https://pavithra-travels-api.onrender.com/api
VITE_API_URL=

# Firebase Web Config (obtain from Firebase Console)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ------------------------------------------
# BACKEND CONFIGURATION (Express)
# ------------------------------------------
PORT=10000
NODE_ENV=production

# Security
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# CORS - Comma-separated list of allowed frontend URLs
# Example: https://pavithra-travels.vercel.app,https://www.pavithratravels.com
CORS_ORIGIN=http://localhost:5173

# Firebase Admin SDK (obtain from Service Accounts)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://your_project.firebaseio.com

# Notifications
OWNER_EMAIL=your_email@example.com
RESEND_API_KEY=your_resend_api_key

# WhatsApp (Meta Cloud API)
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_TOKEN=your_permanent_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_FROM_NUMBER=+15550000000
OWNER_WHATSAPP=+917824047328

# WhatsApp & Contact
VITE_WHATSAPP_NUMBER=+917824047328
VITE_WHATSAPP_DISPLAY="+91 78240 47328"
VITE_OWNER_EMAIL=pavithrashoppee@gmail.com

# Images
VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=dhezpqhgv
CLOUDINARY_API_KEY=295849118922437
